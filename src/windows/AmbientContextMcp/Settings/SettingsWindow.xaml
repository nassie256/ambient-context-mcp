<Window x:Class="AmbientContextMcp.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambient Context MCP 設定"
        Width="600"
        Height="500"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" MinHeight="22" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0">
      <TabItem Header="MCPサーバ">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <GroupBox Header="MCP server" Padding="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="状態" Margin="0,0,12,8" />
              <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="McpStatusText" Margin="0,0,0,8" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint" Margin="0,0,12,8" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="McpEndpointBox" IsReadOnly="True" Margin="0,0,8,8" />
              <Button Grid.Row="1" Grid.Column="2" Content="コピー" Click="OnCopyEndpointClick" MinWidth="64" Margin="0,0,0,8" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Token" Margin="0,0,12,8" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="McpTokenBox" IsReadOnly="True" Margin="0,0,8,8" />
              <Button Grid.Row="2" Grid.Column="2" Content="コピー" Click="OnCopyTokenClick" MinWidth="64" Margin="0,0,0,8" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="ポート" Margin="0,0,12,8" />
              <TextBox Grid.Row="3" Grid.Column="1" x:Name="McpPortBox" Margin="0,0,8,8" />
              <TextBlock Grid.Row="3" Grid.Column="2" Text="変更はアプリ再起動後に反映"
                         VerticalAlignment="Center"
                         FontSize="11"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                         Margin="0,0,0,8" />

              <CheckBox Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        x:Name="McpAutoStartCheckBox"
                        Content="Windows ログイン時に自動起動"
                        Margin="0,4,0,8" />

              <Button Grid.Row="5"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Content="Claude Code 用設定スニペットをコピー"
                      Click="OnCopyClaudeCodeSnippetClick"
                      HorizontalAlignment="Left"
                      MinWidth="240"
                      Margin="0,4,0,0" />
            </Grid>
          </GroupBox>
        </Grid>
      </TabItem>

      <TabItem Header="送信設定">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10"
                     Text="MCPクライアントへ公開してよいコンテキストにチェックを入れてください。未チェックの項目は、クライアントが高い権限を要求しても送信されません。" />

          <CheckBox Grid.Row="1"
                    x:Name="SelectAllTransmissionCheckBox"
                    Content="すべてのコンテキストを許可する"
                    Click="OnToggleAllTransmissionClick"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />

          <GroupBox Grid.Row="2"
                    Header="イベント履歴"
                    Padding="10"
                    Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="保持期間"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox Grid.Column="1"
                        x:Name="EventRetentionHoursBox"
                        SelectedValuePath="Tag"
                        MinWidth="130">
                <ComboBoxItem Content="1時間" Tag="1" />
                <ComboBoxItem Content="6時間" Tag="6" />
                <ComboBoxItem Content="24時間" Tag="24" />
                <ComboBoxItem Content="7日" Tag="168" />
              </ComboBox>

              <TextBlock Grid.Column="3"
                         Text="最大件数"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox Grid.Column="4"
                        x:Name="EventRetentionCountBox"
                        SelectedValuePath="Tag"
                        MinWidth="130">
                <ComboBoxItem Content="100件" Tag="100" />
                <ComboBoxItem Content="500件" Tag="500" />
                <ComboBoxItem Content="1000件" Tag="1000" />
                <ComboBoxItem Content="5000件" Tag="5000" />
              </ComboBox>
            </Grid>
          </GroupBox>

          <Border Grid.Row="3"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                  BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="TransmissionOptionsList" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                            BorderThickness="0,0,0,1"
                            Padding="8,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Click="OnTransmissionOptionClick"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Text="{Binding Path}"
                                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                     FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Sensitivity}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="1"
               x:Name="SettingsStatusText"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               Margin="0,10,0,4" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,4,0,0">
      <Button Content="保存"
              Click="OnSaveClick"
              MinWidth="96"
              Margin="0,0,8,0" />
      <Button Content="閉じる"
              Click="OnCloseClick"
              MinWidth="96"
              Margin="0,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
