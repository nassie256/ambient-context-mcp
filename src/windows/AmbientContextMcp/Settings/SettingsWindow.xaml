<Window x:Class="AmbientContextMcp.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AmbientContextMcp.Resources"
        Title="{x:Static res:Strings.WindowTitle}"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Width="600"
        Height="540"
        MinWidth="600"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" MinHeight="22" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0">
      <TabItem Header="{x:Static res:Strings.TabMcpServer}">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <GroupBox Grid.Row="0" Header="{x:Static res:Strings.McpServerGroup}" Padding="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.LabelStatus}" Margin="0,0,12,8" />
              <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="McpStatusText" Margin="0,0,0,8" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.LabelEndpoint}" Margin="0,0,12,8" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="McpEndpointBox" IsReadOnly="True" Margin="0,0,8,8" />
              <Button Grid.Row="1" Grid.Column="2" Content="{x:Static res:Strings.ButtonCopy}" Click="OnCopyEndpointClick" MinWidth="64" Margin="0,0,0,8" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.LabelToken}" Margin="0,0,12,8" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="McpTokenBox" IsReadOnly="True" Margin="0,0,8,8" />
              <Button Grid.Row="2" Grid.Column="2" Content="{x:Static res:Strings.ButtonCopy}" Click="OnCopyTokenClick" MinWidth="64" Margin="0,0,0,8" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.LabelPort}" Margin="0,0,12,8" />
              <TextBox Grid.Row="3" Grid.Column="1" x:Name="McpPortBox" Margin="0,0,8,8" />
              <TextBlock Grid.Row="3" Grid.Column="2"
                         Text="{x:Static res:Strings.PortChangeNote}"
                         VerticalAlignment="Center"
                         FontSize="11"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                         Margin="0,0,0,8" />

              <CheckBox Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        x:Name="McpAutoStartCheckBox"
                        Content="{x:Static res:Strings.AutoStartCheckbox}"
                        Margin="0,4,0,8" />

              <CheckBox Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        x:Name="PersistEventLogCheckBox"
                        Content="{x:Static res:Strings.PersistEventLogCheckbox}"
                        Margin="0,4,0,2" />

              <TextBlock Grid.Row="6"
                         Grid.Column="0"
                         Grid.ColumnSpan="3"
                         Text="{x:Static res:Strings.PersistEventLogNote}"
                         FontSize="11"
                         Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                         Margin="20,0,0,8" />

              <Button Grid.Row="7"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Content="{x:Static res:Strings.CopyClaudeCodeSnippet}"
                      Click="OnCopyClaudeCodeSnippetClick"
                      HorizontalAlignment="Left"
                      MinWidth="240"
                      Margin="0,4,0,0" />
            </Grid>
          </GroupBox>

          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Static res:Strings.LabelLanguage}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      x:Name="UiLanguageBox"
                      SelectedValuePath="Tag"
                      MinWidth="220"
                      HorizontalAlignment="Left">
              <ComboBoxItem Content="{x:Static res:Strings.LanguageSystemDefault}" Tag="" />
              <ComboBoxItem Content="{x:Static res:Strings.LanguageJapanese}" Tag="ja" />
              <ComboBoxItem Content="{x:Static res:Strings.LanguageEnglish}" Tag="en" />
            </ComboBox>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="{x:Static res:Strings.TabTransmission}">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     TextWrapping="Wrap"
                     Margin="0,0,0,10"
                     Text="{x:Static res:Strings.TransmissionExplanation}" />

          <CheckBox Grid.Row="1"
                    x:Name="SelectAllTransmissionCheckBox"
                    Content="{x:Static res:Strings.AllowAllCheckbox}"
                    Click="OnToggleAllTransmissionClick"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />

          <GroupBox Grid.Row="2"
                    Header="{x:Static res:Strings.EventHistoryGroup}"
                    Padding="10"
                    Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="{x:Static res:Strings.LabelRetention}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox Grid.Column="1"
                        x:Name="EventRetentionHoursBox"
                        SelectedValuePath="Tag"
                        MinWidth="130">
                <ComboBoxItem Content="{x:Static res:Strings.Retention1Hour}" Tag="1" />
                <ComboBoxItem Content="{x:Static res:Strings.Retention6Hours}" Tag="6" />
                <ComboBoxItem Content="{x:Static res:Strings.Retention24Hours}" Tag="24" />
                <ComboBoxItem Content="{x:Static res:Strings.Retention7Days}" Tag="168" />
              </ComboBox>

              <TextBlock Grid.Column="3"
                         Text="{x:Static res:Strings.LabelMaxCount}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <ComboBox Grid.Column="4"
                        x:Name="EventRetentionCountBox"
                        SelectedValuePath="Tag"
                        MinWidth="130">
                <ComboBoxItem Content="{x:Static res:Strings.Count100}" Tag="100" />
                <ComboBoxItem Content="{x:Static res:Strings.Count500}" Tag="500" />
                <ComboBoxItem Content="{x:Static res:Strings.Count1000}" Tag="1000" />
                <ComboBoxItem Content="{x:Static res:Strings.Count5000}" Tag="5000" />
              </ComboBox>
            </Grid>
          </GroupBox>

          <Border Grid.Row="3"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                  BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="TransmissionOptionsList" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                            BorderThickness="0,0,0,1"
                            Padding="8,7">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="88" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Click="OnTransmissionOptionClick"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Label}" />
                          <TextBlock Text="{Binding Path}"
                                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                     FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Sensitivity}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="1"
               x:Name="SettingsStatusText"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               Margin="0,10,0,4" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,4,0,0">
      <Button Content="{x:Static res:Strings.ButtonSave}"
              Click="OnSaveClick"
              MinWidth="96"
              Margin="0,0,8,0" />
      <Button Content="{x:Static res:Strings.ButtonClose}"
              Click="OnCloseClick"
              MinWidth="96"
              Margin="0,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
