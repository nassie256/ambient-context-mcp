<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ambient-mcp</AssemblyName>
    <RootNamespace>AmbientContextMcp</RootNamespace>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      manifest 側で PerMonitorV2 を宣言する理由: ApplicationConfiguration.Initialize() は
      tray STA スレッド起動後にしか走らないため、それより前に MessageOnlyWindow が
      CreateWindowEx で HWND を作ったり、startup capture が EnumDisplayMonitors を
      呼んだ時点で DPI awareness が定まっていないと、起動ごとに 2560x1440 / 3840x2160 が
      ぶれる。manifest なら Windows がプロセスロード時に確定させる。
      ApplicationHighDpiMode は WinForms 内部の Application.HighDpiMode を PerMonitorV2 と
      認識させ、スケーリング判定を manifest 宣言と一致させるために併用する。
      WFAC010: WinForms は manifest と ApplicationHighDpiMode の同時使用に警告するが、
      上記理由で両方必要なので抑止する。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmbientContextMcp.Core\AmbientContextMcp.Core.csproj" />
  </ItemGroup>
</Project>
