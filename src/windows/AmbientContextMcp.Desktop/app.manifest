<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="AmbientContextMcp"/>

  <!--
    PerMonitorV2 を declarative に宣言する。Windows がプロセスロード時に DPI awareness を
    確定させるため、Main() 以降のどのコードが先に EnumDisplayMonitors / GetSystemMetrics
    を呼んでも常に物理ピクセル値が返る。
    過去: ApplicationConfiguration.Initialize() で SetHighDpiMode を呼んでいたが、これは
    tray STA スレッド起動後のタイミングなので、それ以前に MessageOnlyWindow が HWND を
    作成 / startup capture が EnumDisplayMonitors を呼ぶと DPI-Unaware モードに lock され、
    解像度値が起動ごとに揺らいでいた。
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2,PerMonitor</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
