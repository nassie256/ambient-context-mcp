          "title": "Imagine",
          "artist": "John Lennon"
        }
      },
      "expectedDelivered": true,
      "expectedPayloadKeys": [
        "source_app"
      ]
    },
    {
      "name": "events-media-title-opt-in",
      "overrides": {
        "events.media_session_changed": true,
        "events.media_session_changed.title": true
      },
      "event": {
        "name": "media_session_changed",
        "value": "Imagine",
        "sensitivity": "medium",
        "payload": {
          "source_app": "Chrome",
          "title": "Imagine",
          "artist": "John Lennon"
        }
      },
      "expectedDelivered": true,
      "expectedPayloadKeys": [
        "source_app",
        "title"
      ]
    }
