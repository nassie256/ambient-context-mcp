  "filterEvents": [
    {
      "name": "events-default-transmit-low-event",
      "overrides": {},
      "event": {
        "name": "presence_bucket_changed",
        "value": "idle",
        "sensitivity": "low",
        "payload": {
          "from": "active",
          "to": "idle"
        }
      },
      "expectedDelivered": true,
      "expectedPayloadKeys": [
        "from",
        "to"
      ]
    },
    {
      "name": "events-medium-event-dropped-without-opt-in",
      "overrides": {},
      "event": {
        "name": "foreground_title_changed",
        "value": "true",
        "sensitivity": "medium",
        "payload": {
          "process_name": "Code.exe",
          "titleSummary.file_ext": "cs",
          "raw_window_title": "Program.cs - demo"
        }
      },
      "expectedDelivered": false,
      "expectedPayloadKeys": []
    },
    {
      "name": "events-title-changed-strips-raw-title",
      "overrides": {
        "events.foreground_title_changed": true,
        "events.foreground_title_changed.titleSummary": true
      },
      "event": {
        "name": "foreground_title_changed",
        "value": "true",
        "sensitivity": "medium",
        "payload": {
          "process_name": "Code.exe",
          "titleSummary.file_ext": "cs",
          "raw_window_title": "Program.cs - demo"
        }
      },
      "expectedDelivered": true,
      "expectedPayloadKeys": [
        "process_name",
        "titleSummary.file_ext"
      ]
    },
    {
      "name": "events-title-changed-raw-title-opt-in",
      "overrides": {
        "events.foreground_title_changed": true,
        "events.foreground_title_changed.raw_window_title": true
      },
      "event": {
        "name": "foreground_title_changed",
        "value": "true",
        "sensitivity": "medium",
        "payload": {
          "process_name": "Code.exe",
          "titleSummary.file_ext": "cs",
          "raw_window_title": "Program.cs - demo"
        }
      },
      "expectedDelivered": true,
      "expectedPayloadKeys": [
        "process_name",
        "titleSummary.file_ext",
        "raw_window_title"
      ]
    },
    {
      "name": "events-media-overview-only",
      "overrides": {
        "events.media_session_changed": true
      },
      "event": {
        "name": "media_session_changed",
